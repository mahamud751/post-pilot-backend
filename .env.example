NODE_ENV=production
PORT=4000
APP_URL=https://postapi.chapaimango.online/v1
DATABASE_URL=postgresql://username:password@localhost:5432/postpilot
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-web-domain.com,https://www.your-web-domain.com
MAX_FILE_SIZE=524288000

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional signed inbox webhook at APP_URL/webhooks/meta. Subscribe the Meta app/accounts separately.
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_LOGIN_SCOPES=
FACEBOOK_ENABLE_INSTAGRAM_LOGIN=false
FACEBOOK_INSTAGRAM_LOGIN_SCOPES=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for social tokens: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379
# Web app origin (OAuth and email links); optional separate public base for media links
WEB_APP_URL=http://localhost:3000
MEDIA_PUBLIC_URL=
# Comma-separated emails with platform admin access
SUPER_ADMIN_EMAILS=
# log | smtp
EMAIL_DELIVERY=log
# Run the publish worker in this process (on) or in a separate `npm run start:worker` (off)
PUBLISH_WORKER=on
# Billing: manual (admin activates plans) | sslcommerz (verified hosted checkout)
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Sandbox is the default. Set false only with approved live merchant credentials.
SSLCOMMERZ_SANDBOX=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=

# Campaigns use the same API/worker split as publishing. Disable only when another worker handles them.
CAMPAIGN_WORKER=on
# Optional image model overrides; install FFmpeg for Instagram-ready JPEGs and image clips.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1
